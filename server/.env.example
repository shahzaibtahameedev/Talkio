# Copy this file to .env and fill in your values. Never commit .env.

# OpenRouter speaks the OpenAI-compatible API, so any compatible endpoint works here.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-api-key

# An OpenRouter model id (provider/model-name) from https://openrouter.ai/models.
# It must support tool calling and structured outputs (JSON schema).
LLM_MODEL=

# Optional: API port (defaults to 3001).
# PORT=3001
